<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MIG" Version="1.3.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MIG.Audio\MIG.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Optional reproduction of HomeGenie's ONNX runtime collision. -->
  <ItemGroup Condition="'$(TestHostOnnxConflict)' == 'true'">
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" GeneratePathProperty="true" />
    <None Include="$(PkgMicrosoft_ML_OnnxRuntime)/runtimes/**/*"
          Visible="false" Pack="false" CopyToOutputDirectory="PreserveNewest"
          TargetPath="runtimes/host-onnx/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

